STACKNEST_ADDR=127.0.0.1:8080
STACKNEST_DATABASE_URL=postgres://stacknest:stacknest@localhost:15432/stacknest?sslmode=disable
STACKNEST_DATA_DIR=./data
STACKNEST_WEB_DIR=../web/dist
# 本地未启用备份任务时留空；启用后指向独立摘要文件。
STACKNEST_BACKUP_STATUS_FILE=

# 邮件验证码登录；仅首次启动且用户表为空时导入初始邮箱。
STACKNEST_AUTH_ADMIN_EMAIL=admin@example.com
STACKNEST_AUTH_INITIAL_USER_EMAIL=user@example.com
STACKNEST_AUTH_SECRET=replace-with-at-least-32-random-characters
STACKNEST_SMTP_HOST=smtp.qq.com
STACKNEST_SMTP_PORT=465
STACKNEST_SMTP_USER=your-qq-address@qq.com
STACKNEST_SMTP_PASSWORD=replace-with-new-qq-smtp-authorization-code

# 可选邀请：固定的正式 HTTPS 登录地址。留空时使用 STACKNEST_ADMIN_DOMAIN；两者都未设时仍可添加邮箱，但不能发邀请。
# STACKNEST_INVITATION_LOGIN_URL=https://stack-nest.example.com/login

# Docker 生产部署时用于生成项目访问 URL：
# STACKNEST_BASE_DOMAIN=example.com
# 留空可仅开发静态功能；启用后使用独立运行器的 Unix socket。
STACKNEST_RUNNER_SOCKET=
