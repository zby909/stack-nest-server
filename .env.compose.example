COMPOSE_PROJECT_NAME=stacknest
COMPOSE_FILE=compose.yaml:compose.tls.yaml
STACKNEST_ADMIN_DOMAIN=stack-nest.example.com
STACKNEST_BASE_DOMAIN=example.com
# 仅存备份摘要；备份脚本第三个参数和 systemd 配置使用相同目录。
STACKNEST_BACKUP_STATUS_DIR=./backup-status
# 可选覆盖邀请中的登录地址；留空时为 https://STACKNEST_ADMIN_DOMAIN/login。
STACKNEST_INVITATION_LOGIN_URL=
# 标准 TLS 证书目录；放 certificate.pem （完整证书链）和 private.key。
# ORIGIN_CERT_DIR 仅用于可选的 Cloudflare 普通代理源站证书。
STACKNEST_TLS_CERT_DIR=./cert
STACKNEST_ORIGIN_CERT_DIR=./cert

STACKNEST_POSTGRES_PASSWORD=change-this-password
STACKNEST_DATABASE_URL=postgres://stacknest:change-this-password@postgres:5432/stacknest?sslmode=disable

STACKNEST_AUTH_ADMIN_EMAIL=admin@example.com
# 超管为已有管理员邮箱；留空沿用上面的初始部署管理员，不能通过邮箱管理接口授予。
STACKNEST_AUTH_SUPER_ADMIN_EMAIL=
STACKNEST_AUTH_INITIAL_USER_EMAIL=
STACKNEST_AUTH_SECRET=replace-with-at-least-32-random-characters
STACKNEST_SMTP_HOST=smtp.qq.com
STACKNEST_SMTP_PORT=465
STACKNEST_SMTP_USER=your-qq-address@qq.com
STACKNEST_SMTP_PASSWORD=replace-with-new-qq-smtp-authorization-code
# Docker 存储目录仅供运行器检查剩余空间，不开放给用户应用。
STACKNEST_DOCKER_STORAGE_DIR=/var/lib/docker
# 可选：叠加 compose.quota.yaml 才启用，Docker 和应用数据须在同一 XFS＋prjquota。
# 只向受信任 Runner 增加 SYS_ADMIN；每应用持久化目录上限，单位 MiB。
# STACKNEST_APP_DATA_LIMIT_MIB=1024
