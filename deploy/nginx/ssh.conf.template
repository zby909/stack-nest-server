map $http_upgrade $stacknest_ssh_connection {
    default upgrade;
    "" close;
}

# 页面路由保留 SPA 回退，缺失 CSS、脚本、图片等资源直接返回 404。
map $uri $stacknest_ssh_spa_index {
    default /index.html;
    "~*\.(html?|css|[cm]?js|map|json|xml|txt|csv|svg|ico|png|jpe?g|gif|webp|avif|bmp|woff2?|ttf|otf|eot|wasm|webmanifest|pdf|zip|rar|gz|mp4|webm|mp3|ogg|wav)/?$" "";
}

# 回环入口也拒绝未知 Host，避免无效预览域名回退到管理页面。
server {
    listen 82 default_server;
    server_name _;
    return 404;
}

server {
    listen 82;
    server_name localhost 127.0.0.1;

    client_max_body_size 91m;
    root /usr/share/nginx/html;
    index index.html;

    location ~ ^/(api/|sites/|openapi\.yaml$) {
        proxy_pass http://stacknest:8080;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location / {
        try_files $uri $uri/ $stacknest_ssh_spa_index =404;
    }
}

# 预览域名由浏览器解析到回环地址，复用 SSH 本地端口并隔离管理会话。
server {
    listen 82;
    server_name ~^stack-nest-[a-z0-9-]+\.localhost$;
    client_max_body_size 91m;
    location / {
        proxy_pass http://stacknest:8080;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $stacknest_ssh_connection;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
