[Unit]
Description=StackNest application LAN egress policy and configuration
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/stacknest-egress watch
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
RuntimeDirectory=stacknest-egress
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
User=root
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN
ProtectSystem=strict
ReadWritePaths=/etc/stacknest-egress
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
